+/// Tauri's resource directory, where its own bundles (deb, rpm, AppImage) put
+/// mcp-bridge.mjs. Set once the app is running.
+static RESOURCE_DIR: std::sync::OnceLock<PathBuf> = std::sync::OnceLock::new();
+
+pub fn set_resource_dir(dir: PathBuf) {
+    let _ = RESOURCE_DIR.set(dir);
+}
+
+/// The directory holding mcp-bridge.mjs and the Node modules bundled with it.
+///
+/// A packaged install keeps them next to the real executable, and Tauri's own
+/// bundles keep them in its resource directory. Debug builds
+/// (`tauri dev`, `cargo test`) run from the source checkout instead. This used
+/// to be the crate directory baked in at compile time, which pointed every
+/// install at the build machine's checkout, so MCP never started anywhere else.
+pub fn app_dir() -> Option<PathBuf> {
+    let beside_exe = std::env::current_exe()
+        .ok()
+        .and_then(|exe| exe.canonicalize().ok())
+        .and_then(|exe| exe.parent().map(Path::to_path_buf));
+    let candidates = beside_exe.into_iter().chain(RESOURCE_DIR.get().cloned());
+    for dir in candidates {
+        if dir.join("mcp-bridge.mjs").is_file() {
+            return Some(dir);
+        }
+    }
+
+    #[cfg(debug_assertions)]
+    {
+        let dir = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+        if dir.join("mcp-bridge.mjs").is_file() {
+            return Some(dir);
+        }
+    }
+
+    None
+}
+
+/// Command and arguments for a built-in MCP server: the copy bundled with the
+/// app when there is one, so nothing is fetched from npm at launch, otherwise
+/// `npx -y` as before. A TypeScript entry runs through the bundled tsx, since
+/// qwen-core's own launcher would fetch tsx with npx.
+fn builtin_server(package: &str, entry: &str, extra_args: Vec<String>) -> (String, Vec<String>) {
+    let bundled = app_dir().and_then(|dir| {
+        let modules = dir.join("node_modules");
+        let script = modules.join(package).join(entry);
+        if !script.is_file() {
+            return None;
+        }
+        let mut args = Vec::new();
+        if entry.ends_with(".ts") {
+            let tsx = modules.join("tsx").join("dist").join("cli.mjs");
+            if !tsx.is_file() {
+                return None;
+            }
+            args.push(tsx.to_string_lossy().to_string());
+        }
+        args.push(script.to_string_lossy().to_string());
+        Some(args)
+    });
+
+    let (command, mut args) = match bundled {
+        Some(args) => ("node".to_string(), args),
+        None => ("npx".to_string(), vec!["-y".to_string(), package.to_string()]),
+    };
+    args.extend(extra_args);
+    (command, args)
+}
+
+/// Directories the Filesystem server may use: the user's home and /tmp, plus
+/// ~/Projects when it exists. The server refuses to start if any directory it
+/// is given is missing, so only existing ones are passed.
