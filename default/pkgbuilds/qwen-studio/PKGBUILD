# Qwen Studio, an unofficial Qwen chat desktop app for Linux with local MCP
# tools, built from source with the fixes in qwen-studio-fixes.patch:
#
# - Upstream release builds look for their MCP bridge in the build machine's
#   source checkout (the developer's home directory), so MCP tools never start
#   anywhere else. The bridge and the tray icon are now found at run time.
# - The built-in MCP servers run from copies bundled here instead of being
#   fetched with npx at launch, and the Filesystem server gets the user's own
#   home (plus ~/Projects only when it exists) instead of a hardcoded layout.
# - Release builds no longer load tauri-plugin-mcp-bridge, which opens an
#   unauthenticated WebSocket on every network interface (0.0.0.0:9223) that
#   can run JavaScript in the app.
# - MCP and settings commands are available to chat.qwen.ai only, not to every Alibaba
#   domain the app allows for sign-in.
# - The built-in updater stays off: pacman updates the package.
#
# Upstream ships no license file; package.json declares MIT.

pkgname=qwen-studio
pkgver=2.2.3
pkgrel=1
pkgdesc="Unofficial Qwen chat desktop app with local MCP tools"
arch=('x86_64' 'aarch64')
url="https://github.com/youssefvdel/qwen-studio"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'nodejs' 'openssl' 'hicolor-icon-theme')
makedepends=('git' 'rust' 'npm' 'pkgconf')
options=('!lto' '!debug')
_commit=8b1451b0d65ff2e880ba20e6314c6adc9405dc90
source=("$pkgname::git+https://github.com/youssefvdel/qwen-studio.git#commit=$_commit"
        'qwen-studio-fixes.patch'
        'qwen-studio.desktop')
sha256sums=('SKIP'
            '980d990fda39ab35ab3d984544fdaf9d76760b5762501ea451e09c9a4a893e21'
            '6a8afcf9fee84190b37fe8de57b1d0a948dea3521a8016e10c8f774cccd88210')

prepare() {
  cd "$pkgname"
  patch -Np1 -i "$srcdir/qwen-studio-fixes.patch"

  # The app loads chat.qwen.ai; Tauri still wants a frontend directory to embed.
  mkdir -p dist
  printf '<!doctype html><title>Qwen Studio</title>\n' >dist/index.html

  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"

  # Runtime modules for mcp-bridge.mjs and the built-in MCP servers, pinned
  # here so nothing is fetched from npm when the app starts.
  npm ci --omit=dev --ignore-scripts
  npm install --no-save --omit=dev --ignore-scripts \
    @modelcontextprotocol/server-filesystem@1.0.0 \
    @modelcontextprotocol/server-sequential-thinking@1.0.0
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export QWEN_STUDIO_PACKAGED=1
  cargo build --frozen --release --features tauri/custom-protocol
}

package() {
  cd "$pkgname"

  # The binary finds mcp-bridge.mjs and node_modules beside its real path.
  install -Dm755 target/release/qwen-studio "$pkgdir/usr/lib/qwen-studio/qwen-studio"
  install -Dm644 mcp-bridge.mjs mcp-proxy-server.js -t "$pkgdir/usr/lib/qwen-studio/"
  cp -a node_modules "$pkgdir/usr/lib/qwen-studio/"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/qwen-studio/qwen-studio "$pkgdir/usr/bin/qwen-studio"

  install -Dm644 "$srcdir/qwen-studio.desktop" "$pkgdir/usr/share/applications/qwen-studio.desktop"
  install -Dm644 icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/qwen-studio.png"
  install -Dm644 icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/qwen-studio.png"
  install -Dm644 icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/qwen-studio.png"
}
