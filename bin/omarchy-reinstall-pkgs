#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages from the stable channel, or on aarch64 the edge channel
# omarchy:requires-sudo=true

set -e

# Reinstall all default Omarchy packages from the platform's default channel
# (stable, or edge on aarch64) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
omarchy-refresh-pacman

# Downgrade any packages to that channel's setup
omarchy-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(omarchy-pkg-defaults)
mapfile -t packages <<<"$default_packages"
omarchy-update-pacman -Syu --noconfirm --needed "${packages[@]}"

# Firefox is a default package, so a reinstall can be what installs it. Give it
# the policies a fresh install sets up, or it starts with Google's defaults.
firefox_path="${OMARCHY_FIREFOX_PATH:-/usr/lib/firefox}"
if [[ -d $firefox_path ]]; then
  source "$OMARCHY_PATH/install/helpers/browser-policy.sh"
  browser_policy_setup_firefox_distribution "$firefox_path/distribution"
fi
