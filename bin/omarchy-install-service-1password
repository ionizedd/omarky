#!/bin/bash

# omarchy:summary=Install 1Password, with its Chromium extension when Chromium is installed.
# omarchy:requires-sudo=true

set -e

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
EXTENSION_DIR="/usr/share/chromium/extensions"
EXTENSION_FILE="$EXTENSION_DIR/$EXTENSION_ID.json"
WEBSTORE_UPDATE_URL="https://clients2.google.com/service/update2/crx"

install_chromium_extension() {
  sudo mkdir -p "$EXTENSION_DIR"
  printf '{ "external_update_url": "%s" }\n' "$WEBSTORE_UPDATE_URL" | sudo tee "$EXTENSION_FILE" >/dev/null
  sudo chmod 644 "$EXTENSION_FILE"
}

echo "Installing 1Password..."
omarchy-pkg-add 1password 1password-cli

# The Chromium extension comes from the Chrome Web Store. Firefox, the default
# browser, gets 1Password from its own add-on site.
if omarchy-cmd-present chromium; then
  echo "Installing 1Password extension for Chromium..."
  install_chromium_extension
  extension_note="Restart Chromium to load the browser extension."
else
  extension_note="Add the 1Password extension from your browser's add-on store."
fi

echo "Opening 1Password..."
setsid uwsm-app -- 1password >/dev/null 2>&1 &

echo ""
echo "1Password has been installed. $extension_note"
