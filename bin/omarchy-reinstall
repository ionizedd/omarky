#!/bin/bash

# omarchy:summary=Reinstall Omarky packages and reset default configs
# omarchy:requires-sudo=true

set -e

echo -e "This will reinstall all default Omarky packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  omarchy-reinstall-pkgs
  omarchy-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && omarchy-system reboot
fi
